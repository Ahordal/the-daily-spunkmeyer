---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CategoryList from '../../components/CategoryList.astro';
import { getPublishedPosts, formatDate, linkHost, type Post } from '../../utils/posts';
import { isFieldNote, portfolioUrl } from '../../utils/portfolio';
import { getSection, getCategories } from '../../utils/taxonomy';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, summary, link, cover, coverAlt, publishedDate, updatedDate, section, categories } = post.data;
const { Content } = await render(post);
const sectionInfo = getSection(section);
const categoryLabels = getCategories(categories).map((c) => c.label);
const canonical = isFieldNote(post) ? portfolioUrl(post) : undefined;

// Structured data so search engines read the post as an article.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  ...(summary && { description: summary }),
  datePublished: publishedDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Person', name: 'Alex Hordal' },
  mainEntityOfPage: canonical ?? new URL(Astro.url.pathname, Astro.site).href,
  articleSection: sectionInfo.label,
  keywords: categoryLabels.join(', ') || undefined,
};
---

<Base
  title={title}
  description={summary ?? undefined}
  image={cover}
  imageAlt={coverAlt}
  canonical={canonical}
  article={{ publishedDate, updatedDate, tags: categoryLabels }}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <article>
    <header class="post-header">
      <p class="post-meta">
        {/* Field Notes name their section at the head of the category list instead. */}
        {
          section !== 'field-note' && (
            <>
              <a href={sectionInfo.path}>{sectionInfo.singular}</a>
              {' // '}
            </>
          )
        }
        <time datetime={publishedDate.toISOString()}>{formatDate(publishedDate)}</time>
        {
          updatedDate && (
            <>
              {' // Updated '}
              <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </>
          )
        }
      </p>
      <h1 class="post-title">{title}</h1>
      {
        link && (
          <p class="post-link">
            <a href={link} rel="noopener">
              {linkHost(link)} ↗
            </a>
          </p>
        )
      }
      <CategoryList ids={categories} section={section} />
    </header>
    {
      cover && (
        <Image
          class="post-cover"
          src={cover}
          alt={coverAlt ?? ''}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 960px) 960px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
