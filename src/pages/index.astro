---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import CategoryList from '../components/CategoryList.astro';
import { formatDate, getPostsInSection, linkHost } from '../utils/posts';
import { getSection } from '../utils/taxonomy';

// Latest: the newest from each section under one header; each post's filed-in line names its section.
const articles = (await getPostsInSection('article')).slice(0, 3);
const dispatches = (await getPostsInSection('dispatch')).slice(0, 5);
const fieldNotes = (await getPostsInSection('field-note')).slice(0, 2);
const [article, dispatch, fieldNote] = (['article', 'dispatch', 'field-note'] as const).map(getSection);
---

<Base>
  <header class="page-header">
    <h1 class="page-title" data-section="latest"><span>Latest</span></h1>
    <p class="page-intro">The newest from each section.</p>
  </header>
  <div class:list={['front-top', { 'has-rail': dispatches.length > 0 }]}>
    {
      articles.length > 0 && (
        <section class="front-block" aria-label={article.label}>
          <PostList posts={articles} lead />
          <p class="list-more">
            <a href={article.path}>All articles</a>
          </p>
        </section>
      )
    }
    {
      dispatches.length > 0 && (
        <aside class="front-block front-rail" aria-label={dispatch.label}>
          <ol class="rail-list">
            {dispatches.map(({ id, data: { title, publishedDate, link, categories, section } }) => (
              <li>
                <p class="post-meta">
                  <time datetime={publishedDate.toISOString()}>{formatDate(publishedDate)}</time>
                  {link && (
                    <>
                      {' '}
                      · <span class="rail-source">{linkHost(link)}</span>
                    </>
                  )}
                </p>
                <h2 class="rail-title">
                  <a href={`/posts/${id}/`}>{title}</a>
                </h2>
                <CategoryList ids={categories} section={section} />
              </li>
            ))}
          </ol>
          <p class="list-more">
            <a href={dispatch.path}>All dispatches</a>
          </p>
        </aside>
      )
    }
  </div>
  {
    fieldNotes.length > 0 && (
      <section class="front-block front-notes" aria-label={fieldNote.label}>
        <PostList posts={fieldNotes} />
        <p class="list-more">
          <a href={fieldNote.path}>All field notes</a>
        </p>
      </section>
    )
  }
  <p class="list-more">
    <a href="/archive/">Everything in the archive</a>
  </p>
</Base>
