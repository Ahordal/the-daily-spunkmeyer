---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../utils/posts';

// One stream, newest first; older posts live in the archive and on the Topics pages.
const posts = (await getPublishedPosts()).slice(0, 10);
---

<Base>
  <header class="page-header">
    <h1 class="page-title" data-section="latest"><span>Latest</span></h1>
    <p class="page-intro">Newest first.</p>
  </header>
  {
    posts.length > 0 ? (
      <PostList posts={posts} lead />
    ) : (
      <p class="empty-state">Nothing here yet.</p>
    )
  }
  <p class="list-more">
    <a href="/archive/">Everything in the archive</a>
  </p>
</Base>
