---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../utils/posts';

// The front page mixes every section; the archive holds the rest.
const posts = (await getPublishedPosts()).slice(0, 12);
---

<Base>
  <header class="page-header">
    <h1 class="page-title">Latest</h1>
    <p class="page-intro">The newest from every section.</p>
  </header>
  <PostList posts={posts} />
  <p class="list-more"><a href="/archive/">Everything in the archive</a></p>
</Base>
