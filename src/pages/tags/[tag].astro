---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedPosts, collectTags, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const tags = collectTags(await getPublishedPosts());
  return [...tags].map(([slug, { label, posts }]) => ({
    params: { tag: slug },
    props: { label, posts },
  }));
}

interface Props {
  label: string;
  posts: Post[];
}

const { label, posts } = Astro.props;
const count = `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`;
---

<Base title={`Tagged ${label}`} description={`Posts on The Daily Spunkmeyer tagged ${label}.`}>
  <header class="page-header">
    <p class="post-meta"><a href="/tags/">All tags</a> // {count}</p>
    <h1 class="page-title">{label}</h1>
  </header>
  <PostList posts={posts} />
</Base>
