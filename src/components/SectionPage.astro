---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { getPostsInSection } from '../utils/posts';
import { getSection, type SectionId } from '../utils/taxonomy';

interface Props {
  section: SectionId;
}

const { section } = Astro.props;
const { label, description } = getSection(section);
const posts = await getPostsInSection(section);
---

<Base title={label} description={description}>
  <header class="page-header">
    <h1 class="page-title" data-section={section}><span>{label}</span></h1>
    <p class="page-intro"><slot name="intro">{description}</slot></p>
  </header>
  {
    posts.length > 0 ? (
      <PostList posts={posts} showSection={false} />
    ) : (
      <p class="empty-state">Nothing here yet.</p>
    )
  }
</Base>
