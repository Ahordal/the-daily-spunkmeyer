---
import { Image } from 'astro:assets';
import CategoryList from './CategoryList.astro';
import { formatDate, formatSerial, getSerials, linkHost, type Post } from '../utils/posts';

interface Props {
  posts: Post[];
  /** Give the first post Latest's lead treatment: full-width cover, bigger headline. */
  lead?: boolean;
}

const { posts, lead = false } = Astro.props;
const serials = await getSerials();
---

<ol class="post-list">
  {
    posts.map((post, i) => {
      const { title, summary, cover, publishedDate, categories, link } = post.data;
      const href = `/posts/${post.id}/`;
      const isLead = lead && i === 0;
      return (
        <li class:list={['post-item', { 'has-cover': cover, 'post-item-lead': isLead }]}>
          {cover && (
            <a class="post-item-cover" href={href} tabindex="-1" aria-hidden="true">
              {isLead ? (
                <Image src={cover} alt="" widths={[640, 1280]} sizes="(min-width: 52rem) 640px, 100vw" />
              ) : (
                <Image src={cover} alt="" widths={[320, 640]} sizes="(min-width: 720px) 240px, 100vw" />
              )}
            </a>
          )}
          <div class="post-item-body">
            <p class="post-meta">
              {formatSerial(serials.get(post.id)!)} //{' '}
              <time datetime={publishedDate.toISOString()}>{formatDate(publishedDate)}</time>
            </p>
            <h2 class="post-item-title">
              <a href={href}>{title}</a>
            </h2>
            {summary && <p class="post-item-summary">{summary}</p>}
            {link && (
              <p class="post-item-link">
                <a href={link} rel="noopener">
                  {linkHost(link)} ↗
                </a>
              </p>
            )}
            <CategoryList ids={categories} />
          </div>
        </li>
      );
    })
  }
</ol>
