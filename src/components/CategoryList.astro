---
import { getCategories, topicPath, type CategoryId } from '../utils/taxonomy';

interface Props {
  ids: readonly CategoryId[];
  /** Link each category to its Topics page. */
  linked?: boolean;
}

const { ids, linked = true } = Astro.props;
const categories = getCategories(ids);
---

{
  categories.length > 0 && (
    <div class="category-row">
      <span class="filed-in" aria-hidden="true">
        Filed in:
      </span>
      <ul class="category-list" aria-label="Filed in">
        {categories.map((c) => (
          <li style={`--category: ${c.color}`}>
            {linked ? (
              <a class="category" href={topicPath(c.id)}>
                {c.label}
              </a>
            ) : (
              <span class="category">{c.label}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  )
}
