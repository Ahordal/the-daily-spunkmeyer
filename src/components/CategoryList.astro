---
import { getCategories, getSection, type CategoryId, type SectionId } from '../utils/taxonomy';

interface Props {
  ids: readonly CategoryId[];
  /** A Field Note leads its list with the section, ahead of the categories. */
  section?: SectionId;
  /** Link each category to the archive, filtered to it. */
  linked?: boolean;
}

const { ids, section, linked = true } = Astro.props;
const categories = getCategories(ids);
const lead = section === 'field-note' ? getSection(section) : null;
---

{
  (lead || categories.length > 0) && (
    <ul class="category-list" aria-label="Categories">
      {lead && (
        <li>
          {linked ? (
            <a class="category category-section" href={lead.path}>
              {lead.label}
            </a>
          ) : (
            <span class="category category-section">{lead.label}</span>
          )}
        </li>
      )}
      {categories.map((c) => (
        <li style={`--category: ${c.color}`}>
          {linked ? (
            <a class="category" href={`/archive/?category=${c.id}`}>
              {c.label}
            </a>
          ) : (
            <span class="category">{c.label}</span>
          )}
        </li>
      ))}
    </ul>
  )
}
