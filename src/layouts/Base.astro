---
interface Props {
  title?: string;
}

const { title } = Astro.props;
const siteName = 'The Daily Spunkmeyer';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- .ico first so browsers that support SVG favicons still pick the SVG. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} | ${siteName}` : siteName}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&display=swap" />
  </head>
  <body>
    <header class="site-header">
      <a href="/">
        <img src="/logo.svg" alt="" width="44" height="44" />
        <span>The Daily <em>Spunkmeyer</em></span>
      </a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
  }
  /* Logo's own colours, so the header reads the same in light and dark mode. */
  .site-header {
    --navy: #232f78;
    --red: #e8222b;
    background: var(--navy);
    padding: 14px max(16px, env(safe-area-inset-left, 0px)) 24px;
    position: relative;
  }
  /* USCM-style red/white/red stripe along the bottom edge. */
  .site-header::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 10px;
    background: linear-gradient(var(--red) 0 4px, #fff 4px 6px, var(--red) 6px 10px);
  }
  .site-header a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    text-decoration: none;
    font: 700 clamp(22px, 4vw, 30px) / 1 'Barlow Condensed', 'Arial Narrow', Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .site-header em {
    font-style: normal;
  }
  .site-header a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }
</style>
