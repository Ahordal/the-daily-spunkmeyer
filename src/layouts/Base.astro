---
import '@fontsource-variable/nunito-sans';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getEdition, formatDate } from '../utils/posts';
import { SECTIONS } from '../utils/taxonomy';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | null;
  imageAlt?: string | null;
  /** Absolute URL when another site holds the original (dev posts live on the portfolio). */
  canonical?: string;
  article?: {
    publishedDate: Date;
    updatedDate?: Date | null;
    /** Category labels, for article:tag. */
    tags: string[];
  };
}

const siteName = 'The Daily Spunkmeyer';
const defaultDescription = 'A blog by Alex Hordal.';
const { title, description = defaultDescription, image, imageAlt, article } = Astro.props;

const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, Astro.site);

// Link previews need an absolute URL to a JPEG at the standard 1200x630.
const preview = image
  ? await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : null;
const previewUrl = new URL(preview ? preview.src : '/og-default.png', Astro.site);
const previewAlt = image ? (imageAlt ?? '') : `${siteName} logo`;

const edition = await getEdition();
const path = Astro.url.pathname;
// "/" would prefix-match every page, so Latest only lights up on the home page itself.
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const primaryLinks = [{ href: '/', label: 'Latest' }, ...SECTIONS.map((s) => ({ href: s.path, label: s.label }))];
const secondaryLinks = [
  { href: '/archive/', label: 'Archive' },
  { href: '/about/', label: 'About' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- .ico first so browsers that support SVG favicons still pick the SVG. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={new URL('/rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={previewAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedDate.toISOString()} />
          {article.updatedDate && (
            <meta property="article:modified_time" content={article.updatedDate.toISOString()} />
          )}
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        {
          edition && (
            <p class="masthead-edition">
              Vol. {edition.volume} // No. {edition.number} //{' '}
              <time datetime={edition.date.toISOString()}>{formatDate(edition.date)}</time>
            </p>
          )
        }
        <a class="site-brand" href="/">
          <img src="/logo.svg" alt="" width="44" height="44" />
          <span class="site-title">{siteName}</span>
        </a>
        <div class="masthead-rule" aria-hidden="true"></div>
        <nav class="site-nav" aria-label="Site">
          <ul class="site-nav-primary">
            {
              primaryLinks.map((l) => (
                <li>
                  <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <ul class="site-nav-secondary">
            {
              secondaryLinks.map((l) => (
                <li>
                  <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main class="container site-main">
      <slot />
    </main>
  </body>
</html>
